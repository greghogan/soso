#!/bin/sh
set -eu

# Git runs pre-push from the working-tree root and provides the outgoing refs on stdin.
[ "${1:-}" = origin ] || exit 0
while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$remote_ref" = refs/heads/main ] || continue
    [ "$local_ref" != '(delete)' ] || continue
    exec uv run --locked python -m soso.assets.pre_push "$local_oid" </dev/null
done
